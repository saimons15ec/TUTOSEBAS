# Correos administradores separados por comas.
# Usa únicamente valores de ejemplo en este archivo.
ADMIN_EMAILS=admin@example.com

# Sigue usando Sites hasta verificar la instalación independiente.
APP_AUTH_MODE=sites
APP_DEPLOYMENT=sites
# En el hosting propio: password. Sin proveedor/origen válidos, rechaza el acceso.
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo secreto de servidor. Nunca NEXT_PUBLIC_, GitHub, chat o navegador.
SUPABASE_SECRET_KEY=

# DB y BUCKET son bindings de runtime, no secretos de texto.
# En Sites se declaran como D1 y R2 en .openai/hosting.json.
