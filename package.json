{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.*",
    "test:final-exams": "node --experimental-strip-types --test tests/final-exam-api.test.mjs",
    "test:security": "node --experimental-strip-types --test tests/security.test.ts",
    "test:access": "node --experimental-strip-types --test tests/plans-access-api.test.mjs",
    "db:generate": "drizzle-kit generate",
    "test:blocks": "node --experimental-strip-types --test tests/question-blocks.test.ts",
    "test:documents": "node --experimental-strip-types --test tests/question-documents.test.ts",
    "test:topics": "node --experimental-strip-types --test tests/academic-topics.test.ts",
    "test:formats": "node --experimental-strip-types --test tests/academic-formats.test.ts",
    "test:resources": "node --experimental-strip-types --test tests/additional-resources.test.ts tests/resources-courses-api.test.mjs tests/resource-sections-api.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@xmldom/xmldom": "^0.9.12",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
